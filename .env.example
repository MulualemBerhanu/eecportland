# 1) Copy this file:  cp .env.example .env.local
# 2) Put the real mailbox password in .env.local only (never commit .env.local)
# 3) Restart: npm run dev
# 4) Test at http://localhost:3000/members
# Same keys go in Vercel → Settings → Environment Variables before launch.

# From IONOS → ⋮ → "Setting up an email client" → manual setup (outgoing SMTP)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@eecportland.org
SMTP_PASS=your-ionos-mailbox-password

# Must match SMTP_USER (the mailbox that sends mail)
FORM_FROM_EMAIL=info@eecportland.org
# Backward-compatible alias:
MEMBERSHIP_FROM_EMAIL=info@eecportland.org

# Comma-separated inboxes for ALL forms (contact, prayer, membership, etc.)
FORM_NOTIFY_EMAIL=info@eecportland.org,getuandargie@eecportland.org
# Backward-compatible alias:
MEMBERSHIP_NOTIFY_EMAIL=info@eecportland.org,getuandargie@eecportland.org

# Optional: send a short confirmation to the applicant
# MEMBERSHIP_SEND_APPLICANT_CONFIRMATION=true

# YouTube (optional)
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
